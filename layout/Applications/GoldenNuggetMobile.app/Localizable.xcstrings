    "AirLift needs a pairing record and none is stored. Import one on the home page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirLift 需要一份配对记录，但目前没有存储任何记录。请先在主页导入一份。"
          }
