          }
        }
      }
    },
    "%@ has nothing in it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 里什么都没有。"
          }
        }
      }
    },
    "%@ on the device, removed with no trash and no undo." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备上的 %@ 已被删除，没有废纸篓，也无法撤销。"
          }
        }
      }
    },
    "%@ uses the legacy %@ format." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ uses the legacy %2$@ format."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 使用旧版 %2$@ 格式。"
          }
        }
      }
    },
    "%@ will be copied into this app's container. Files larger than 64 MiB will also stay on the device. Free space there: %@. Once removed, the copy in the container is the only one -- and the container is deleted if the app is." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ will be copied into this app's container. Files larger than 64 MiB will also stay on the device. Free space there: %2$@. Once removed, the copy in the container is the only one -- and the container is deleted if the app is."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 将被拷贝到本 App 的容器中。大于 64 MiB 的文件也会继续留在设备上。那里的可用空间：%2$@。一旦移除，容器中的拷贝就是唯一一份 -- 而且如果删除 App，容器也会随之删除。"
          }
        }
      }
    },
    "%@ · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ — %lld file(s), %lld key(s) found." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ — %2$lld file(s), %3$lld key(s) found."
